{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harness 项目实例配置",
  "type": "object",
  "required": ["schema_version", "project", "harness"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "object",
      "required": ["name", "lang", "stack", "packageManager"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "lang": { "type": "string", "description": "ts|java|python|go|... " },
        "stack": { "type": "string", "description": "react|vue|java-spring|node|python|none|..." },
        "packageManager": { "type": "string", "description": "pnpm|npm|yarn|maven|gradle|..." },
        "testEntry": { "type": ["string", "null"] },
        "buildCommand": { "type": ["string", "null"] },
        "workspaces": {
          "type": "array",
          "description": "monorepo 各工作区的技术栈清单（仅 monorepo 根生成）",
          "items": {
            "type": "object",
            "required": ["rel", "lang", "stack", "packageManager"],
            "additionalProperties": false,
            "properties": {
              "rel": { "type": "string", "description": "相对根的路径" },
              "lang": { "type": "string" },
              "stack": { "type": "string" },
              "packageManager": { "type": "string" }
            }
          }
        }
      }
    },
    "harness": {
      "type": "object",
      "required": ["assuranceDefault", "artifactLang", "rolesEnabled", "installedSkills", "hooks"],
      "additionalProperties": false,
      "properties": {
        "assuranceDefault": {
          "type": "string",
          "enum": ["fast", "standard", "high-assurance"]
        },
        "artifactLang": { "type": "string", "default": "zh" },
        "rolesEnabled": {
          "type": "array",
          "items": { "type": "string" }
        },
        "installedSkills": {
          "type": "array",
          "items": { "type": "string" }
        },
        "agents": {
          "type": "array",
          "items": { "type": "string", "enum": ["claude", "codex", "opencode", "pi"] },
          "minItems": 1,
          "description": "已生成脚手架的 agent 清单"
        },
        "hooks": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}