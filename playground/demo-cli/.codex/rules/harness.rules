# ============================================================
# Harness Starlark 执行策略（Codex exec-policy）
# 原则：默认只放行 harness 脚本与 git/只读操作；危险路径收紧。
# 与 .harness/scripts/ 及 AGENTS.md 安全红线保持一致。
# ============================================================

# 放行 harness 自身脚本与只读/证据操作。
allow(
    "*.sh: .harness/scripts/**",
    reason="harness 运行时脚本（证据/文件挂钩）",
)

# git 与只读操作：Codex/CLI 需要可观察项目状态。
allow(
    "git status",
    "git diff",
    "git log",
    "git show",
    "git branch",
    "git fetch",
    "git stash",
    "ls",
    "cat",
    "find",
    "grep",
    reason="只读与 git 观察操作",
)

# 允许在 .harness host-sessions/ 与各阶段产物目录内写证据账本。
allow(
    "*.sh: .harness/scripts/evidence.sh **",
    reason="证据写入",
)

# ------------------------------------------------------------
# 收紧：危险 / 破坏性 / 提权 / 网络 / 密码类路径一律默认拒绝。
# ------------------------------------------------------------
deny(
    "rm -rf **",
    "sudo **",
    "chmod 777 **",
    "chown **",
    "dd **",
    "mkfs **",
    "shutdown **",
    "reboot **",
    reason="破坏性与提权命令默认拒绝；确需时由用户显式确认",
)

# 网络访问：AGENTS.md 红线「默认不联网」，仅用户明确要求时放行。
deny(
    "curl **",
    "wget **",
    "nc **",
    "telnet **",
    "ssh **",
    "scp **",
    reason="默认不联网；外部访问必须用户明确触发并写入证据",
)

# 秘密读取：禁止读取/打印凭据文件。
deny(
    "cat ~/.ssh/**",
    "cat ~/.aws/credentials",
    "cat ~/.config/gh/hosts.yml",
    "env **",
    reason="不读取、不打印、不提交密码/Token/私钥/完整环境变量",
)

# 用户数据保护：禁止越界删除项目外或用户文件。
deny(
    "rm ~/**",
    "rm /Users/**",
    reason="不删除用户文件、旧数据或冲突源文件",
)

# 未见明确规则的操作：保持默认拒绝（fail-closed），由用户审批。