{
  "schema_version": 1,
  "project": {
    "name": "MonorepoDemo",
    "lang": "multi",
    "stack": "monorepo",
    "packageManager": "pnpm",
    "testEntry": null,
    "buildCommand": null,
    "workspaces": [
      {
        "rel": "backend",
        "stack": "java-spring",
        "lang": "java",
        "packageManager": "maven"
      },
      {
        "rel": "frontend",
        "stack": "vue",
        "lang": "ts",
        "packageManager": "pnpm"
      },
      {
        "rel": "frontend2",
        "stack": "react",
